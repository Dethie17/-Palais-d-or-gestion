# ── O RESTO — Configuration ─────────────────────────────
# L'app démarre SANS ces clés (mode démo local).
# Avec ces clés : persistance Supabase (PostgreSQL + RLS).
# Obtenez-les depuis Supabase Dashboard → Settings → API.

VITE_SUPABASE_URL=https://votre-projet.supabase.co
VITE_SUPABASE_ANON_KEY=votre_cle_anon_publique_ici

# Optionnel — nom affiché / support
# VITE_APP_NAME=O RESTO
# VITE_SUPPORT_PHONE=+221770000000

# Optionnel — compte marchand Wave (paiements mobiles)
# VITE_WAVE_MERCHANT_NUMBER=+221770000000
# VITE_WAVE_MERCHANT_NAME=O RESTO

# Instructions:
# 1. Créez un compte sur https://supabase.com/
# 2. Créez un nouveau projet
# 3. SQL Editor → exécutez supabase-setup.sql PUIS supabase-oresto-migration.sql
# 4. Settings > API → copiez Project URL + anon public key
# 5. En local : cp .env.example .env.local (puis renseignez les 2 valeurs)
# 6. Sur Netlify/Vercel : ajoutez les 2 mêmes variables d'environnement, puis redéployez
