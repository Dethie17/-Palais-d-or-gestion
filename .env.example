# ── O RESTO — Configuration ─────────────────────────────
# L'app démarre SANS ces clés (mode démo local).
# Avec ces clés : persistance Supabase (PostgreSQL + RLS).
# Obtenez-les depuis Supabase Dashboard → Settings → API.

VITE_SUPABASE_URL=https://votre-projet.supabase.co
# Nouveaux projets Supabase : clé publishable (sb_publishable_...)
# Anciens projets : clé anon (eyJhbGciOi...)
# L'app accepte les deux noms de variable :
VITE_SUPABASE_PUBLISHABLE_KEY=votre_cle_publishable_ici
# VITE_SUPABASE_ANON_KEY=votre_cle_anon_publique_ici

# Optionnel — nom affiché / support
# VITE_APP_NAME=O RESTO
# VITE_SUPPORT_PHONE=+221770000000

# Optionnel — compte marchand Wave (paiements mobiles)
# VITE_WAVE_MERCHANT_NUMBER=+221770000000
# VITE_WAVE_MERCHANT_NAME=O RESTO

# Optionnel — compte marchand InTouch (paiements mobiles)
# VITE_INTOUCH_MERCHANT_NUMBER=+221770000000
# VITE_INTOUCH_MERCHANT_NAME=O RESTO

# Lien de paiement Wave Business (caisse POS) : QR + bouton sur l'écran
# d'encaissement. Le client paie le montant exact, le caissier confirme
# après la notification Wave Business.
# VITE_WAVE_BUSINESS_URL=https://pay.wave.com/m/M_sn_1ZFaHP4di8qG/c/sn/
# VITE_WAVE_BUSINESS_NAME=O RESTO

# Sécurité login — mettez "false" en production dès que de vrais comptes
# Supabase existent : les comptes de démonstration (client/client123…)
# ne pourront plus se connecter et ne seront plus affichés.
# VITE_DEMO_LOGIN=false

# Instructions:
# 1. Créez un compte sur https://supabase.com/
# 2. Créez un nouveau projet
# 3. SQL Editor → exécutez dans l'ordre : supabase-setup.sql, supabase-oresto-migration.sql, supabase-oresto-full.sql, supabase-ism-wallet.sql, supabase-tarifs-2026.sql, supabase-depenses.sql, supabase-menus-semaine.sql, supabase-cycles-2026.sql, supabase-parents-2026.sql, supabase-site-ism-2026.sql, supabase-solde-carte.sql, supabase-menus-items.sql, supabase-intouch.sql
# 4. Settings > API → copiez Project URL + publishable key (ou anon key)
# 5. En local : cp .env.example .env.local (puis renseignez les 2 valeurs)
# 6. Sur Netlify/Vercel : ajoutez les 2 mêmes variables d'environnement, puis redéployez
