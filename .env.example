# ── O RESTO — Configuration ─────────────────────────────
# L'app démarre SANS ces clés (mode démo local).
# Avec ces clés : persistance Supabase (PostgreSQL + RLS).
# Obtenez-les depuis Supabase Dashboard → Settings → API.

VITE_SUPABASE_URL=https://votre-projet.supabase.co
# Nouveaux projets Supabase : clé publishable (sb_publishable_...)
# Anciens projets : clé anon (eyJhbGciOi...)
# L'app accepte les deux noms de variable :
VITE_SUPABASE_PUBLISHABLE_KEY=votre_cle_publishable_ici
# VITE_SUPABASE_ANON_KEY=votre_cle_anon_publique_ici

# Optionnel — nom affiché / support
# VITE_APP_NAME=O RESTO
# VITE_SUPPORT_PHONE=+221770000000

# Optionnel — compte marchand Wave (paiements mobiles)
# VITE_WAVE_MERCHANT_NUMBER=+221770000000
# VITE_WAVE_MERCHANT_NAME=O RESTO

# Supabase Service Role Key (fonctions serveur uniquement)
# NE JAMAIS mettre dans VITE_* (exposé côté client)
# SUPABASE_SERVICE_ROLE_KEY=votre_service_role_key_ici

# ══════════════════════════════════════════════════════════════
# SycaPay — passerelle de paiement (Wave / Orange Money / carte)
# ══════════════════════════════════════════════════════════════
# L'API SycaPay s'authentifie par mTLS : la clé privée ne peut pas
# sortir du runtime serveur. Les certificats vivent donc dans les
# variables CI (Vercel), en base64, et JAMAIS dans VITE_*.
#
# Demandez le certificat au support SycaPay : ca.crt, client.crt,
# client.key. Convertissez-les en base64 mono-ligne :
#   base64 -w0 client.crt
#
# Sans ces variables, l'application démarre et bascule d'elle-même en
# mode démonstration (code à 6 chiffres, aucun argent ne circule).
#
# SYCAPAY_ENABLED=false            # coupe la passerelle, force la démo
# SYCAPAY_BASE_URL=https://ops.sycapay.com/coresystem/part/api
# SYCAPAY_LOGIN_API=MIAMS
# SYCAPAY_MDP_API=votre_mot_de_passe_api
# SYCAPAY_CA_CRT=LS0tLS1CRUdJTi...
# SYCAPAY_CLIENT_CRT=LS0tLS1CRUdJTi...
# SYCAPAY_CLIENT_KEY=LS0tLS1CRUdJTi...
#
# Secret HMAC des notifications (une chaîne, celle du back-office
# SycaPay). Sans lui, le webhook REFUSE toute notification : c'est
# volontaire — un webhook non authentifié laisserait n'importe qui
# activer des abonnements.
# SYCAPAY_WEBHOOK_SECRET=votre_secret_hmac
# SYCAPAY_WEBHOOK_HMAC_ALGO=sha256     # ou sha512
# SYCAPAY_WEBHOOK_HMAC_HEADER=X-Sycapay-Signature
# SYCAPAY_WEBHOOK_REQUIRE_SIGNATURE=true
#
# Adresse publique de l'application : SycaPay exige que les adresses
# de retour soient en https (codes 1120/1121 sinon).
# VITE_APP_URL=https://oresto.vercel.app

# Lien de paiement Wave Business (caisse POS) : QR + bouton sur l'écran
# d'encaissement. Le client paie le montant exact, le caissier confirme
# après la notification Wave Business.
# VITE_WAVE_BUSINESS_URL=https://pay.wave.com/m/M_sn_1ZFaHP4di8qG/c/sn/
# VITE_WAVE_BUSINESS_NAME=O RESTO

# Sécurité login — laissez à false, ou supprimez la variable.
# Les comptes de démonstration (client/client123…) ne sont acceptés que si
# cette variable vaut explicitement true. En production elle doit être
# absente ou false : seule l'authentification Supabase Auth, vérifiée
# côté serveur, est alors acceptée.
# VITE_DEMO_LOGIN=false

# Clé de service Supabase — FONCTIONS SERVEUR UNIQUEMENT (jamais VITE_*).
# Indispensable à /api/sycapay/* et /api/auth/* : sans elle, le webhook
# SycaPay ne peut pas solder un paiement et aucun compte ne peut être créé.
# Dashboard Supabase → Project Settings → API → service_role
# SUPABASE_SERVICE_ROLE_KEY=votre_cle_service_role

# Expiration des sessions (défauts : 20 minutes, 12 heures).
# Inactivité → préavis 60 s puis déconnexion ; durée max → déconnexion même actif.
# VITE_SESSION_IDLE_MINUTES=20
# VITE_SESSION_MAX_HOURS=12

# MISE EN PRODUCTION — dans cet ordre :
# 1. Renseignez SUPABASE_URL + SUPABASE_SERVICE_ROLE_KEY ci-dessus.
# 2. SQL Editor : exécutez supabase-security.sql
#    (retire les politiques RLS USING (true), lie chaque table à auth.uid()).
# 3. Authentication → Providers → Email : désactivez « Confirm email »
#    (sinon l'inscription d'un parent ne rend pas de session).
#    LAISSEZ « Enable email signup » ACTIVÉ : les parents créent eux-mêmes
#    leur compte. Un inscrit sans profil ne voit rien, et la politique RLS
#    interdit de s'attribuer un rôle autre que 'client'.
# 4. Authentication → Users : créez admin@oresto.local,
#    personnel@oresto.local, gestionnaire@oresto.local.
#    Faites-le AVANT d'ouvrir le site, sinon ces adresses peuvent être
#    réservées par quelqu'un d'autre. Les parents n'ont pas de compte à créer.
# 5. SQL Editor : exécutez supabase-link-accounts.sql
#    (rattache chaque profil métier à son compte Auth, sans uuid à copier).
# 6. Contrôle : select * from public.check_anon_exposure() where exposed;
#    doit renvoyer zéro ligne.
# 7. Vérifiez que VITE_DEMO_LOGIN est absent ou false, puis redéployez.

# Instructions:
# 1. Créez un compte sur https://supabase.com/
# 2. Créez un nouveau projet
# 3. SQL Editor → exécutez dans l'ordre : supabase-setup.sql, supabase-oresto-migration.sql, supabase-oresto-full.sql, supabase-ism-wallet.sql, supabase-tarifs-2026.sql, supabase-depenses.sql, supabase-menus-semaine.sql, supabase-menus-price.sql, supabase-cycles-2026.sql, supabase-parents-2026.sql, supabase-site-ism-2026.sql, supabase-solde-carte.sql, supabase-menus-items.sql, supabase-kiosk-orders.sql, supabase-reclamations.sql, supabase-sycapay.sql
# 4. Settings > API → copiez Project URL + publishable key (ou anon key)
# 5. En local : cp .env.example .env.local (puis renseignez les 2 valeurs)
# 6. Sur Netlify/Vercel : ajoutez les 2 mêmes variables d'environnement, puis redéployez
# 7. SycaPay (optionnel) : voir docs/SYCAPAY_INTEGRATION.md — certificats,
#    mTLS et les variables serveur. Testez d'abord sans : l'app reste utilisable.
#
# MISE EN SERVICE (production) — l'ordre compte, le détail dans SECURITY.md :
#   1. supabase-security.sql      retire les RLS USING (true), lie à auth.uid()
#   2. créer les comptes dans Authentication -> Users
#   3. supabase-link-accounts.sql rattache profil <-> compte Auth, sans uuid
